{
  "expo": {
    "name": "Enruta",
    "slug": "Enruta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icono-principal.png",
    "scheme": "Enruta",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.enruta.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icono-principal.png",
        "backgroundColor": "#2563EB"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE"
      ]
    },

    "androidStatusBar": {
      "backgroundColor": "#2563EB",
      "barStyle": "light-content"
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icono-principal.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2563EB"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {}
    }
  }
}